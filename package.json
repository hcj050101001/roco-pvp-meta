{
  "name": "roco-pvp-meta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run images:derive && astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "validate": "tsx scripts/validate/data.ts",
    "validate:evidence-report": "tsx scripts/validate/evidence-report.ts",
    "images:derive": "tsx scripts/build/derive-images.ts",
    "build": "npm run validate && npm run images:derive && astro build && tsx scripts/validate/site.ts && tsx scripts/validate/build-state.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "research:collect": "tsx scripts/collect/run.ts",
    "research:validate": "tsx scripts/validate/research.ts",
    "research:coverage": "tsx scripts/research/coverage-report.ts",
    "lineup:rank": "tsx scripts/rank/run.ts",
    "links:check": "tsx scripts/validate/links.ts",
    "refresh:guard": "tsx scripts/validate/refresh-guard.ts",
    "publish:plan": "tsx scripts/validate/publish-plan.ts",
    "refresh:snapshot": "tsx scripts/validate/refresh-guard.ts --snapshot",
    "research:discover": "tsx scripts/collect/run.ts --discover",
    "research:full": "tsx scripts/collect/run.ts --discover --browser",
    "research:vision": "tsx scripts/research/prepare-vision.ts",
    "research:record": "tsx scripts/research/record-decisions.ts",
    "season:check": "tsx scripts/collect/season.ts"
  },
  "dependencies": {
    "astro": "5.16.6",
    "cheerio": "1.1.2",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
