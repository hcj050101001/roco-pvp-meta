---
import LineupCard from './LineupCard.astro';
import Icon from './Icon.astro';
import type { Lineup } from '../lib/schema';
import { withBase } from '../lib/urls';
import { PAGE_SIZE } from '../lib/collection-filter';
import { staticPageCount, staticPagePath } from '../lib/static-pages';
interface Props {
  lineups: Lineup[];
  fallback?: Lineup[];
  historical?: boolean;
  initialPage?: number;
}
const { lineups, fallback = [], historical = false, initialPage = 1 } = Astro.props;
const filters = [...new Set(lineups.flatMap((l) => l.archetype))];
const firstPage = lineups.slice((initialPage - 1) * PAGE_SIZE, initialPage * PAGE_SIZE);
const staticPages = staticPageCount(lineups.length);
---

<div
  class="collection"
  data-collection
  data-index-set={historical ? 'history' : 'active'}
  data-total-count={lineups.length}
  data-initial-page={initialPage}
  data-root-path={staticPagePath(1, historical)}
>
  <div class="filter-panel">
    <form class="collection-tools" role="search" onsubmit="return false">
      <label class="search-box">
        <Icon name="search" size={20} />
        <span class="sr-only">搜索阵容或精灵</span>
        <input
          id="search"
          type="search"
          placeholder="搜索阵容、精灵或体系"
          autocomplete="off"
          disabled
        />
      </label>
      <label class="sort-label">
        排列方式{' '}
        <select id="sort" aria-describedby="sort-explanation" disabled>
          <option value="recommended">近期线索优先</option>
          <option value="recent">配置发布时间</option>
        </select>
      </label>
    </form>
    <div class="filter-row">
      <span class="filter-label" id="system-label">
        配队体系
      </span>
      <div class="filter-bar" role="group" aria-labelledby="system-label">
        <button class="filter active" data-filter="all" aria-pressed="true" disabled>
          全部体系
        </button>
        {filters.map((f) => (
          <button class="filter" data-filter={f} aria-pressed="false" disabled>
            {f}
          </button>
        ))}
      </div>
    </div>
    <details class="sort-note">
      <summary>关于近期线索优先</summary>
      <p id="sort-explanation" class="sort-explanation">
        45 天内有来源的公开实绩或热度记录属于同一优先组；组内按配置发布日期排列。超过 45
        天的记录仍可在详情页查看，不按近期线索排序。
      </p>
    </details>
  </div>
  <noscript>
    <p class="index-status">
      搜索与筛选需要启用脚本；
      {staticPages > 1 ? '可使用分页链接浏览全部阵容。' : '下方阵容卡片仍可浏览。'}
    </p>
  </noscript>
  <div class="collection-result">
    <div class="result-summary">
      <span id="result-count" role="status" aria-live="polite">
        共 {lineups.length} 套阵容
      </span>
      <button id="clear-filters" class="clear-filters" hidden disabled>
        <Icon name="close" size={14} />
        清除筛选
      </button>
    </div>
    <label class="video-filter">
      <input type="checkbox" id="with-video" disabled />
      <span class="switch-track" aria-hidden="true"></span>有教学视频
    </label>
  </div>
  <div id="lineup-grid" class="lineup-grid" role="region" tabindex="-1" aria-label="阵容列表">
    {firstPage.map((l, i) => (
      <LineupCard
        lineup={l}
        index={(initialPage - 1) * PAGE_SIZE + i}
        historical={historical}
        fallback={fallback.includes(l)}
        returnTo={
          initialPage > 1
            ? `${staticPagePath(initialPage, historical)}#lineup-${l.slug}`
            : undefined
        }
      />
    ))}
  </div>
  {staticPages > 1 && (
    <nav class="pagination static-pagination" aria-label="静态阵容分页">
      {initialPage > 1 && <a href={staticPagePath(initialPage - 1, historical)}>上一页</a>}
      <span aria-current="page">
        第 {initialPage} / {staticPages} 页
      </span>
      {initialPage < staticPages && (
        <a href={staticPagePath(initialPage + 1, historical)}>下一页</a>
      )}
    </nav>
  )}
  <nav class="pagination" id="pagination" aria-label="阵容分页" hidden>
    <button id="prev-page" type="button" aria-label="上一页">
      上一页
    </button>
    <span id="page-numbers" class="page-numbers"></span>
    <button id="next-page" type="button" aria-label="下一页">
      下一页
    </button>
  </nav>
  <p class="index-status" id="index-status" role="status" aria-live="polite" hidden></p>
  <div class="empty-state" id="empty-state" role="status" aria-live="polite" hidden>
    <span class="empty-icon">
      <Icon name="search" size={26} />
    </span>
    <h3>没有找到符合条件的阵容</h3>
    <p>换个关键词，或清除筛选，重新发现喜欢的队伍。</p>
    <div class="empty-actions">
      <button class="button primary" id="reset-search" disabled>
        重置筛选
      </button>
      {!historical && (
        <a class="button secondary" href={withBase('/history/')}>
          浏览往期阵容
        </a>
      )}
    </div>
  </div>
</div>
<script>
  import { readCollectionState, writeCollectionState, clampPage } from '../lib/collection-state';
  import {
    filterCollection,
    sortCollection,
    paginate,
    PAGE_SIZE,
    type CollectionCard,
  } from '../lib/collection-filter';
  import { initImageFallback } from '../client/image-fallback';
  // 索引卡片与 LineupCard 的渲染字段一一对应；卡片模板见下方 cardHtml，
  // 其标记、类名与 data 属性与 LineupCard.astro 保持一致。
  interface IndexCard extends CollectionCard {
    slug: string;
    name: string;
    archetype: string[];
    label: 'current' | 'fallback' | 'historical';
    dateKind: 'published' | 'season';
    dateText: string;
    roster: string;
    image: {
      src: string;
      srcset?: string;
      avifSrcset?: string;
      sizes?: string;
      width: number;
      height: number;
    };
    videos: { url: string; platform: string; title: string }[];
    href: string;
  }
  const escapeHtml = (value: string) =>
    value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  const ICON_PATHS = {
    diagonal: 'M6 18 18 6M6 6h12v12',
    arrow: 'M4 12h16m-6-6 6 6-6 6',
    play: 'm9 5 11 7-11 7V5Z',
  };
  const icon = (path: string, size: number) =>
    `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon"><path d="${path}"></path></svg>`;
  function cardHtml(card: IndexCard): string {
    const label =
      card.label === 'fallback'
        ? '过渡参考'
        : card.label === 'historical'
          ? '往期配队'
          : '当季配队';
    const img = card.image;
    const srcset = img.srcset
      ? ` srcset="${escapeHtml(img.srcset)}" sizes="${escapeHtml(img.sizes ?? '')}"`
      : '';
    const avif = img.avifSrcset
      ? `<source type="image/avif" srcset="${escapeHtml(img.avifSrcset)}" sizes="${escapeHtml(img.sizes ?? '')}" />`
      : '';
    const fetchpriority = card.index === 0 ? ' fetchpriority="high"' : '';
    const videos = card.videos
      .map(
        (v) =>
          `<a class="video-link" href="${escapeHtml(v.url)}" target="_blank" rel="noopener noreferrer" title="${escapeHtml(v.title)}">${icon(ICON_PATHS.play, 14)}${escapeHtml(v.platform)}教学</a>`,
      )
      .join('');
    return (
      `<article id="lineup-${escapeHtml(card.slug)}" class="lineup-card" data-card data-season="${escapeHtml(card.season)}" data-search="${escapeHtml(card.search)}" data-types="${escapeHtml(card.archetype.join('|'))}" data-date="${escapeHtml(card.date)}" data-index="${card.index}" data-video="${card.video ? 'yes' : 'no'}">` +
      `<a href="${escapeHtml(card.href)}" class="card-link">` +
      `<div class="card-top"><span class="card-number"><span class="status-dot"></span>${escapeHtml(card.season)} / ${escapeHtml(card.archetype[0])}</span><span class="card-label">${label}</span></div>` +
      `<div class="card-image"><picture>${avif}<img src="${escapeHtml(img.src)}"${srcset} width="${img.width}" height="${img.height}" alt="${escapeHtml(card.name)}完整六只精灵与技能配置一图流" loading="${card.index < 3 ? 'eager' : 'lazy'}" decoding="async"${fetchpriority} data-image-fallback /></picture><p class="image-load-fallback" aria-live="polite" hidden>图片暂时无法加载，可稍后重试。</p></div>` +
      `<div class="card-content"><div class="card-title"><h3>${escapeHtml(card.name)}</h3><span class="card-arrow">${icon(ICON_PATHS.diagonal, 18)}</span></div>` +
      `<div class="tags">${card.archetype.map((t) => `<span>${escapeHtml(t)}</span>`).join('')}</div>` +
      `<p class="card-roster">${escapeHtml(card.roster)}</p></div></a>` +
      `<div class="card-bottom"><span class="card-date">${card.dateKind === 'published' ? '配置发布' : '所属赛季'}<strong>${escapeHtml(card.dateText)}</strong></span><div class="card-actions">${videos}<a class="card-cta" href="${escapeHtml(card.href)}">查看配置 ${icon(ICON_PATHS.arrow, 16)}</a></div></div></article>`
    );
  }
  function pageButtons(totalPages: number, current: number): string {
    if (totalPages <= 1) return '';
    const pages: number[] = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      const set = new Set([1, totalPages, current - 1, current, current + 1]);
      pages.push(...[...set].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b));
    }
    let html = '',
      prev = 0;
    for (const p of pages) {
      if (prev && p - prev > 1) html += '<span class="page-ellipsis" aria-hidden="true">…</span>';
      html += `<button type="button" class="page-number${p === current ? ' active' : ''}" data-page="${p}" aria-label="第 ${p} 页"${p === current ? ' aria-current="page"' : ''}>${p}</button>`;
      prev = p;
    }
    return html;
  }
  document.querySelectorAll<HTMLElement>('[data-collection]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('#search')!,
      sort = root.querySelector<HTMLSelectElement>('#sort')!,
      video = root.querySelector<HTMLInputElement>('#with-video')!;
    const grid = root.querySelector<HTMLElement>('#lineup-grid')!;
    const pagination = root.querySelector<HTMLElement>('#pagination')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('#prev-page')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('#next-page')!;
    const pageNumbers = root.querySelector<HTMLElement>('#page-numbers')!;
    const resultCount = root.querySelector<HTMLElement>('#result-count')!;
    const emptyState = root.querySelector<HTMLElement>('#empty-state')!;
    const indexStatus = root.querySelector<HTMLElement>('#index-status')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('#clear-filters')!;
    const types = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const seasons = [...document.querySelectorAll<HTMLButtonElement>('[data-season-filter]')];
    [
      input,
      sort,
      video,
      ...types,
      ...seasons,
      clearBtn,
      root.querySelector<HTMLButtonElement>('#reset-search')!,
    ].forEach((control) => {
      control.disabled = false;
    });
    const indexSet = root.dataset.indexSet ?? 'active';
    const initialPage = Number(root.dataset.initialPage) || 1;
    const staticPagination = root.querySelector<HTMLElement>('.static-pagination');
    // 首屏服务端卡片：仅在索引尚未加载且状态为默认时直接沿用，不做重渲染。
    const ssrCards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const ssrData: CollectionCard[] = ssrCards.map((card) => ({
      search: card.dataset.search!,
      types: card.dataset.types!.split('|'),
      season: card.dataset.season!,
      video: card.dataset.video === 'yes',
      date: card.dataset.date!,
      index: Number(card.dataset.index),
      title: card.querySelector('h3')!.textContent!,
    }));
    const ssrElementByData = new Map(ssrData.map((d, i) => [d, ssrCards[i]]));
    let indexData: IndexCard[] | null = null;
    let indexPromise: Promise<IndexCard[] | null> | null = null;
    async function loadIndex(): Promise<IndexCard[] | null> {
      if (indexData) return indexData;
      if (!indexPromise) {
        indexPromise = (async () => {
          try {
            const response = await fetch(
              `${import.meta.env.BASE_URL}collection-index-${indexSet}.json`,
            );
            if (!response.ok) return null;
            const entries: unknown = await response.json();
            if (!Array.isArray(entries)) return null;
            indexData = (entries as unknown as IndexCard[]).map(
              (entry) => ({ ...entry, types: entry.archetype, title: entry.name }) as IndexCard,
            );
            return indexData;
          } catch {
            return null;
          }
        })();
      }
      return indexPromise;
    }

    let type = 'all',
      season = 'all',
      page = 1;
    let lastState = '',
      lastFilterKey = '',
      frame = 0,
      pendingSync = true,
      updateToken = 0,
      scrollToGrid = false;
    function queue(sync = true) {
      pendingSync ||= sync;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const syncNow = pendingSync;
        pendingSync = true;
        void update(syncNow);
      });
    }
    const attachFallback = initImageFallback;
    async function update(sync = true) {
      const token = ++updateToken;
      const filterKey = JSON.stringify([input.value, type, season, video.checked, sort.value]);
      // 筛选任一变化都回到第 1 页；仅翻页不触发重置。
      if (filterKey !== lastFilterKey) {
        page = 1;
        lastFilterKey = filterKey;
      }
      const activeState = Boolean(
        input.value.trim() ||
        type !== 'all' ||
        season !== 'all' ||
        video.checked ||
        sort.value !== 'recommended' ||
        page !== 1,
      );
      let data: CollectionCard[] = ssrData;
      let renderData: IndexCard[] | null = indexData;
      if (!renderData && activeState) {
        indexStatus.hidden = false;
        indexStatus.textContent = '正在加载完整阵容索引…';
        renderData = await loadIndex();
        if (token !== updateToken) return;
        if (renderData) data = renderData;
        else {
          page = initialPage;
          indexStatus.innerHTML =
            '完整阵容索引加载失败。<button type="button" id="retry-index">重试</button>';
          root.querySelector('#retry-index')?.addEventListener(
            'click',
            () => {
              indexPromise = null;
              queue();
            },
            { once: true },
          );
        }
      } else if (!renderData) {
        data = ssrData;
      } else if (renderData) data = renderData;
      if (renderData) indexStatus.hidden = true;
      const state = {
        query: input.value,
        type,
        season,
        video: video.checked,
        sort: sort.value,
        page,
      };
      const visible = filterCollection(data, state);
      const sorted = sortCollection(visible, sort.value);
      const paged = paginate(sorted, renderData ? page : 1);
      if (renderData && paged.page !== page) page = paged.page;
      const stateKey = JSON.stringify([input.value, type, season, video.checked, sort.value, page]);
      const stateChanged = stateKey !== lastState;
      lastState = stateKey;
      const next = writeCollectionState(new URL(location.href), {
        query: input.value,
        type,
        season,
        video: video.checked,
        sort: sort.value,
        page,
      });
      if (sync && initialPage > 1) next.pathname = root.dataset.rootPath!;
      if (sync && stateChanged && next.href !== location.href)
        history.replaceState(history.state, '', next);
      const count = renderData
        ? visible.length
        : activeState
          ? visible.length
          : Number(root.dataset.totalCount);
      if (renderData) {
        const currentIds = [...grid.querySelectorAll<HTMLElement>('[data-card]')].map((c) => c.id);
        const nextIds = paged.items.map((card) => `lineup-${(card as IndexCard).slug}`);
        if (JSON.stringify(currentIds) !== JSON.stringify(nextIds)) {
          grid.innerHTML = paged.items.map((card) => cardHtml(card as IndexCard)).join('');
          attachFallback(grid);
        }
      } else {
        const shown = new Set(paged.items);
        ssrCards.forEach((card, i) => {
          card.hidden = !shown.has(ssrData[i]);
        });
        paged.items.forEach((item) => {
          const el = ssrElementByData.get(item);
          if (el) grid.append(el);
        });
      }
      // returnTo：每次渲染后重写，翻页后的详情返回能回到正确页。
      grid.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
        card.querySelectorAll<HTMLAnchorElement>('.card-link,.card-cta').forEach((link) => {
          const url = new URL(link.href);
          url.searchParams.set('returnTo', `${location.pathname}${location.search}#${card.id}`);
          link.href = url.href;
        });
      });
      const start = count === 0 ? 0 : (paged.page - 1) * PAGE_SIZE + 1,
        end = Math.min(paged.page * PAGE_SIZE, count);
      resultCount.textContent =
        !renderData && !activeState
          ? `共 ${count} 套阵容`
          : !renderData && activeState
            ? `共 ${Number(root.dataset.totalCount)} 套阵容 · 索引不可用，当前显示本页`
            : count === 0
              ? `共 0 套阵容`
              : `共 ${count} 套阵容 · 第 ${paged.page} / ${paged.totalPages} 页（第 ${start}–${end} 套）`;
      emptyState.hidden = count > 0;
      clearBtn.hidden = !(
        input.value.trim().toLowerCase() ||
        type !== 'all' ||
        season !== 'all' ||
        video.checked ||
        sort.value !== 'recommended' ||
        page !== 1
      );
      types.forEach((b) => {
        b.classList.toggle('active', b.dataset.filter === type);
        b.setAttribute('aria-pressed', String(b.dataset.filter === type));
      });
      seasons.forEach((b) => {
        b.classList.toggle('active', b.dataset.seasonFilter === season);
        b.setAttribute('aria-pressed', String(b.dataset.seasonFilter === season));
      });
      pagination.hidden = paged.totalPages <= 1 || count === 0;
      if (staticPagination) staticPagination.hidden = Boolean(renderData);
      prevBtn.disabled = paged.page <= 1;
      nextBtn.disabled = paged.page >= paged.totalPages;
      pageNumbers.innerHTML = pageButtons(paged.totalPages, paged.page);
      if (scrollToGrid) {
        scrollToGrid = false;
        grid.focus({ preventScroll: true });
        grid.scrollIntoView();
      }
    }
    async function restore() {
      const state = readCollectionState(
        new URL(location.href),
        types.map((b) => b.dataset.filter!),
        seasons.map((b) => b.dataset.seasonFilter!),
      );
      if (!new URL(location.href).searchParams.has('page') && initialPage > 1)
        state.page = initialPage;
      input.value = state.query;
      type = state.type;
      season = state.season;
      video.checked = state.video;
      sort.value = state.sort;
      page = state.page;
      lastFilterKey = JSON.stringify([
        state.query,
        state.type,
        state.season,
        state.video,
        state.sort,
      ]);
      await update(false);
      // 超出总页数被钳制时，把 URL 修正为钳制后的页码（不产生历史记录）。
      if (page !== state.page) {
        const corrected = writeCollectionState(new URL(location.href), {
          query: input.value,
          type,
          season,
          video: video.checked,
          sort: sort.value,
          page,
        });
        if (initialPage > 1) corrected.pathname = root.dataset.rootPath!;
        if (corrected.href !== location.href) history.replaceState(history.state, '', corrected);
      }
      if (location.hash.startsWith('#lineup-'))
        document.getElementById(location.hash.slice(1))?.scrollIntoView();
    }
    let searchTimer = 0;
    input.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => queue(), 120);
    });
    sort.addEventListener('change', () => queue());
    video.addEventListener('change', () => queue());
    types.forEach((b) =>
      b.addEventListener('click', () => {
        type = b.dataset.filter!;
        queue();
      }),
    );
    seasons.forEach((b) =>
      b.addEventListener('click', () => {
        season = b.dataset.seasonFilter!;
        queue();
      }),
    );
    pagination.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      if (!button || button.disabled) return;
      if (button.id === 'prev-page') page = clampPage(page - 1);
      else if (button.id === 'next-page') page = clampPage(page + 1);
      else if (button.dataset.page) page = clampPage(Number(button.dataset.page));
      else return;
      scrollToGrid = true;
      queue();
    });
    function reset() {
      clearTimeout(searchTimer);
      type = 'all';
      season = 'all';
      input.value = '';
      video.checked = false;
      sort.value = 'recommended';
      page = 1;
      queue();
      input.focus();
    }
    root.querySelector('#reset-search')!.addEventListener('click', reset);
    root.querySelector('#clear-filters')!.addEventListener('click', reset);
    window.addEventListener('popstate', () => {
      void restore();
    });
    void restore();
  });
</script>
