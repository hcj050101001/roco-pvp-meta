---
import type { Lineup } from '../lib/schema';
import { withBase, displayDate } from '../lib/urls';
import { configurationDate } from '../lib/rank';
import Icon from './Icon.astro';
import { cardImageSources } from '../lib/card-image';
import { platformLabels } from '../lib/platforms';
import { normalizeSearch } from '../lib/collection-filter';
interface Props {
  lineup: Lineup;
  index: number;
  historical?: boolean;
  fallback?: boolean;
  returnTo?: string;
}
const { lineup: l, index, historical = false, fallback = false, returnTo } = Astro.props;
const img = l.lineup_images[0],
  updated = configurationDate(l);
const { src: cardSrc, srcset: cardSrcset, avifSrcset, sizes: cardSizes } = cardImageSources(img);
const href = `${withBase(`/lineups/${l.slug}/`)}${returnTo ? `?returnTo=${encodeURIComponent(returnTo)}` : ''}`;
const labelKind = fallback ? 'fallback' : historical ? 'historical' : 'current';
const labelText = fallback ? '过渡参考' : historical ? '往期配队' : '当季配队';
const folio = String(index + 1).padStart(2, '0');
---

<article
  id={`lineup-${l.slug}`}
  class="lineup-card"
  data-card
  data-season={l.season}
  data-search={[l.name, ...l.aliases, ...l.archetype, ...l.roster.map((p) => p.name)]
    .map(normalizeSearch)
    .join(' ')}
  data-types={l.archetype.join('|')}
  data-date={updated}
  data-index={index}
  data-video={l.tutorials.length > 0 ? 'yes' : 'no'}
>
  <a href={href} class="card-link">
    <div class="card-top">
      <span class="card-number">
        <span class="status-dot"></span>
        <strong>{l.season}</strong>
        <span class="card-sep" aria-hidden="true">
          /
        </span>
        <span>{l.archetype[0]}</span>
      </span>
      <span class={`card-label card-label--${labelKind}`}>
        <span class="card-folio" aria-hidden="true">
          #{folio}
        </span>
        {labelText}
      </span>
    </div>
    <div class="card-image">
      <picture>
        {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={cardSizes} />}
        <img
          src={cardSrc}
          srcset={cardSrcset}
          sizes={cardSizes}
          width={img.width}
          height={img.height}
          alt={`${l.name}完整六只精灵与技能配置一图流`}
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : undefined}
          data-image-fallback
        />
      </picture>
      <p class="image-load-fallback" aria-live="polite" hidden>
        图片暂时无法加载，可稍后重试。
      </p>
    </div>
    <div class="card-content">
      <div class="card-title">
        <h3>{l.name}</h3>
        <span class="card-arrow">
          <Icon name="diagonal" size={16} />
        </span>
      </div>
      <div class="tags">
        {l.archetype.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <div class="card-roster">
        {l.roster.map((p) => (
          <span class="pet-chip">{p.name}</span>
        ))}
      </div>
    </div>
  </a>
  <div class="card-bottom">
    <span class="card-date">
      {updated ? '配置发布' : '所属赛季'}
      <strong>{updated ? displayDate(updated) : l.season}</strong>
    </span>
    <div class="card-actions">
      {l.tutorials.length > 0 ? (
        l.tutorials.map((t) => (
          <a
            class="video-link"
            href={t.url}
            target="_blank"
            rel="noopener noreferrer"
            title={t.title}
          >
            <Icon name="play" size={13} />
            {platformLabels[t.platform]}教学
          </a>
        ))
      ) : (
        <span class="card-gap">暂无对应教学</span>
      )}
      <a class="card-cta" href={href}>
        查看配置 <Icon name="arrow" size={15} />
      </a>
    </div>
  </div>
</article>
