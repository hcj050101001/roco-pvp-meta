---
import '../styles/player.css';
import { withBase } from '../lib/urls';
import { activeLineups, currentSeason, historyLineups } from '../lib/data';
import { absoluteUrl, SITE_DESCRIPTION, SITE_NAME, serializeJsonLd } from '../lib/seo';
import Icon from '../components/Icon.astro';
interface Props {
  title: string;
  description?: string;
  section?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description = SITE_DESCRIPTION,
  section = '',
  image,
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const cover =
  image ?? activeLineups[0]?.lineup_images[0]?.path ?? historyLineups[0]?.lineup_images[0]?.path;
const ogImage = cover ? absoluteUrl(withBase(cover)) : undefined;
const structured = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_CN" />
    {!noindex && <meta property="og:url" content={canonical.href} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {structured.map((node) => (
      <script type="application/ld+json" set:html={serializeJsonLd(node)}></script>
    ))}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} · 洛克配队手册</title>
  </head>
  <!-- 固定浅色是产品规则，不随赛季换色 -->
  <body data-theme="light">
    <a href="#main" class="skip-link">
      跳到正文
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a href={withBase('/')} class="brand">
          <span class="brand-symbol" aria-hidden="true">
            <Icon name="book" size={21} />
          </span>
          <span class="brand-text">
            洛克配队手册<small>ROCO KINGDOM · PVP ATLAS</small>
          </span>
        </a>
        <nav aria-label="主导航">
          <a href={withBase('/')} aria-current={section === 'overview' ? 'page' : undefined}>
            当季阵容
          </a>
          <a href={withBase('/history/')} aria-current={section === 'history' ? 'page' : undefined}>
            往期阵容
          </a>
          <a
            href={withBase('/timeline/')}
            aria-current={section === 'timeline' ? 'page' : undefined}
          >
            时间线
          </a>
          <a href={withBase('/compare/')} aria-current={section === 'compare' ? 'page' : undefined}>
            阵容对比
          </a>
          <a href={withBase('/systems/')} aria-current={section === 'systems' ? 'page' : undefined}>
            体系共现
          </a>
        </nav>
        <a class="season-pill" href={withBase('/#lineup-overview')}>
          <span class="status-dot"></span>
          <span class="season-pill-text">
            <strong>{currentSeason.id}</strong> · {currentSeason.name}
          </span>
          <Icon name="diagonal" size={14} />
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-col-brand">
          <a class="footer-brand" href={withBase('/')}>
            <span class="footer-emblem" aria-hidden="true">
              <Icon name="book" size={16} />
            </span>
            洛克配队手册
          </a>
          <p class="footer-motto">
            面向《洛克王国：世界》玩家的配队图鉴。收录真实完整配置图、作者原话与对应教学视频。
          </p>
        </div>
        <nav class="footer-links" aria-label="页脚导航">
          <a href={withBase('/')}>当季阵容</a>
          <a href={withBase('/history/')}>往期阵容</a>
          <a href={withBase('/timeline/')}>配置时间线</a>
          <a href={withBase('/compare/')}>阵容对比</a>
          <a href={withBase('/systems/')}>体系共现图</a>
        </nav>
        <div class="footer-meta">
          <p class="footer-season-tag">
            <span class="status-dot"></span>
            当前收录基准：{currentSeason.id} · {currentSeason.name}
          </p>
          <p>非官方玩家图鉴 · 配置图与视频归原作者所有</p>
          <a
            class="footer-feedback"
            href="https://github.com/hcj050101001/roco-pvp-meta/issues"
            target="_blank"
            rel="noopener noreferrer"
          >
            反馈与纠错 <Icon name="diagonal" size={13} />
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
