---
import '../styles/player.css';
import { withBase } from '../lib/urls';
import { currentSeason } from '../lib/data';
interface Props { title: string; description?: string; section?: string }
const { title, description = '洛克王国：世界 PVP 阵容大全。查强度梯度、找体系配队、回顾往期阵容。', section = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#101529" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} · 洛克配队手册</title>
  </head>
  <body data-theme={currentSeason.theme}>
    <div class="sky" aria-hidden="true"></div>
    <a href="#main" class="skip-link">跳到正文</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a href={withBase('/')} class="brand" aria-label="洛克配队手册首页"><span class="brand-symbol" aria-hidden="true">☾</span><span>洛克配队手册<small>ROCO KINGDOM · PVP</small></span></a>
        <nav aria-label="主导航"><a href={withBase('/')} aria-current={section==='overview'?'page':undefined}>当季阵容</a><a href={withBase('/history/')} aria-current={section==='history'?'page':undefined}>往期阵容</a></nav>
        <span class="season-pill"><span></span>{currentSeason.id} · {currentSeason.name}</span>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href={withBase('/')}>☾ 洛克配队手册</a><p>{currentSeason.id} · {currentSeason.name}</p></div>
      <div><p>非官方玩家站 · 配置图归原作者所有</p><a href="https://github.com/hcj050101001/roco-pvp-meta/issues" target="_blank" rel="noopener noreferrer">反馈与纠错 ↗</a></div>
    </footer>
  </body>
</html>
