---
import '../styles/global.css';
import { withBase } from '../lib/urls';
interface Props { title: string; description?: string; section?: string }
const { title, description = '洛克王国：世界 PVP 阵容图鉴。完整真实一图流、打法解析与可追溯来源，找到适合你的下一套阵容。', section = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#f8f9f7" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} · 洛克配队手册</title>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a href={withBase('/')} class="brand" aria-label="洛克配队手册首页"><span class="brand-symbol" aria-hidden="true">✦</span><span>洛克配队手册<small>ROCO / FIELD NOTES</small></span></a>
        <nav aria-label="主导航"><a href={withBase('/')} aria-current={section==='overview'?'page':undefined}>阵容图鉴</a><a href={withBase('/method/')} aria-current={section==='method'?'page':undefined}>收录准则</a><a href={withBase('/updates/')} aria-current={section==='updates'?'page':undefined}>更新记录</a></nav>
        <span class="season-pill"><span></span>S4 · 月涌狂想</span>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href={withBase('/')}>✦ 洛克配队手册</a><p>每一次出发，都有一份好配队。</p></div>
      <div><p>玩家整理的非官方网站 · 图片与内容归原作者所有</p><a href="https://github.com/hcj050101001/roco-pvp-meta" target="_blank" rel="noopener noreferrer">项目与纠错 ↗</a><span class="footer-separator">/</span><a href={withBase('/method/')}>来源与收录说明</a></div>
    </footer>
  </body>
</html>
