---
import Layout from '../layouts/Layout.astro';
import { allLineups } from '../lib/data';
import { breadcrumbJsonLd } from '../lib/seo';
import ComparePanel from '../components/ComparePanel.astro';

const lineups = allLineups
  .filter((lineup) => lineup.lineup_images.some((image) => image.verified))
  .sort((a, b) => a.name.localeCompare(b.name, 'zh-CN') || a.slug.localeCompare(b.slug));
---

<Layout
  title="阵容对比"
  description="并排查看两套已核验阵容的精灵、技能、血脉和体系标签。"
  section="compare"
  jsonLd={breadcrumbJsonLd([
    { name: '阵容图鉴', path: '/' },
    { name: '阵容对比', path: '/compare/' },
  ])}
>
  <div class="wrap data-page">
    <header class="data-page-heading">
      <h1>阵容对比</h1>
      <p>选择两套已核验阵容，并排查看已记录的配置事实。</p>
    </header>
    <div class="compare-controls">
      <label>
        第一套阵容
        <select id="compare-first" disabled>
          {lineups.map((lineup, index) => (
            <option value={lineup.slug} selected={index === 0}>
              {lineup.season} · {lineup.name}
            </option>
          ))}
        </select>
      </label>
      <label>
        第二套阵容
        <select id="compare-second" disabled>
          {lineups.map((lineup, index) => (
            <option value={lineup.slug} selected={index === 1}>
              {lineup.season} · {lineup.name}
            </option>
          ))}
        </select>
      </label>
    </div>
    <p id="compare-status" role="status" aria-live="polite">
      正在对比{lineups[0].season} · {lineups[0].name}与{lineups[1].season} · {lineups[1].name}。
    </p>
    <div class="compare-grid">
      <section id="compare-left" aria-label="第一套阵容">
        <ComparePanel lineup={lineups[0]} />
      </section>
      <section id="compare-right" aria-label="第二套阵容">
        <ComparePanel lineup={lineups[1]} />
      </section>
    </div>
    {lineups.map((lineup) => (
      <template data-compare-template={lineup.slug}>
        <ComparePanel lineup={lineup} />
      </template>
    ))}
  </div>
</Layout>
<script>
  const first = document.querySelector<HTMLSelectElement>('#compare-first');
  const second = document.querySelector<HTMLSelectElement>('#compare-second');
  const left = document.querySelector<HTMLElement>('#compare-left');
  const right = document.querySelector<HTMLElement>('#compare-right');
  const status = document.querySelector<HTMLElement>('#compare-status');
  if (first && second && left && right && status) {
    first.disabled = false;
    second.disabled = false;
    function render() {
      if (!first || !second || !left || !right || !status) return;
      if (first.value === second.value) {
        status.textContent = '请选择两套不同的阵容。';
        left.replaceChildren();
        right.replaceChildren();
        return;
      }
      const templates = [
        ...document.querySelectorAll<HTMLTemplateElement>('[data-compare-template]'),
      ];
      const a = templates.find((item) => item.dataset.compareTemplate === first.value);
      const b = templates.find((item) => item.dataset.compareTemplate === second.value);
      if (!a || !b) return;
      left.replaceChildren(a.content.cloneNode(true));
      right.replaceChildren(b.content.cloneNode(true));
      status.textContent = `正在对比${first.selectedOptions[0].textContent}与${second.selectedOptions[0].textContent}。`;
    }
    first.addEventListener('change', render);
    second.addEventListener('change', render);
    render();
  }
</script>
