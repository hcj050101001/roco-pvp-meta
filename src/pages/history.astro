---
import Layout from '../layouts/Layout.astro';
import Collection from '../components/Collection.astro';
import { historyLineups,seasons,state } from '../lib/data';
import { seasonNumber } from '../lib/rank';
import { withBase } from '../lib/urls';
const choices=seasons.filter(s=>historyLineups.some(l=>l.season===s.id)).sort((a,b)=>seasonNumber(b.id)-seasonNumber(a.id));
---
<Layout title="往期阵容" section="history"><div class="wrap history-page"><header class="history-hero"><div class="eyebrow">THE SEASONS WE PLAYED</div><h1>那些年，<span>一起上分的队伍。</span></h1><p>翻回旧赛季，重看曾经的版本答案。</p><a href={withBase('/')} class="text-link">← 返回当季阵容</a></header>
  <nav class="season-tabs" aria-label="历史赛季"><button class="active" data-season-filter="all" aria-pressed="true">全部赛季 <span>{historyLineups.length}</span></button>{choices.map(s=><button data-season-filter={s.id} aria-pressed="false">{s.id} · {s.name}<span>{historyLineups.filter(l=>l.season===s.id).length}</span></button>)}</nav>
  <p class="history-note">历史梯度仅对应当时环境；当前赛季为 {state.season} · {state.version_label}。</p>
  <Collection lineups={historyLineups} historical />
  {!historyLineups.length&&<div class="empty-state"><h2>往期阵容陆续整理中</h2><p>先去看看这个赛季有哪些配队。</p></div>}
</div></Layout>
