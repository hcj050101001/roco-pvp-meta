---
import Layout from '../layouts/Layout.astro';
import Collection from '../components/Collection.astro';
import Icon from '../components/Icon.astro';
import { historyLineups, seasons, state } from '../lib/data';
import { seasonNumber } from '../lib/rank';
import { withBase } from '../lib/urls';
const choices = seasons
  .filter((s) => historyLineups.some((l) => l.season === s.id))
  .sort((a, b) => seasonNumber(b.id) - seasonNumber(a.id));
const description =
  '洛克配队手册往期赛季阵容存档。按赛季翻阅真实配置图、作者攻略与教学视频，了解当时版本下的配队思路。';
---

<Layout
  title="往期阵容"
  description={description}
  image={historyLineups[0]?.lineup_images[0]?.path}
  section="history"
>
  <div class="wrap history-page">
    <header class="history-hero">
      <div>
        <div class="eyebrow">
          <span class="eyebrow-line"></span> THE SEASON ARCHIVE
        </div>
        <h1>
          赛季翻篇，
          <br />
          <span>配队灵感留在这里。</span>
        </h1>
        <p>翻回熟悉的赛季，重温那些各有特色的队伍。</p>
        <a href={withBase('/')} class="text-link">
          ← 返回当季阵容
        </a>
      </div>
      <div class="archive-mark">
        <Icon name="book" size={28} />
        <strong>{String(historyLineups.length).padStart(2, '0')}</strong>
        <span>套往期配队 · {choices.length} 个赛季</span>
      </div>
    </header>
    <nav class="season-tabs" aria-label="历史赛季">
      <button class="active" data-season-filter="all" aria-pressed="true" disabled>
        全部赛季 <span>{historyLineups.length}</span>
      </button>
      {choices.map((s) => (
        <button data-season-filter={s.id} aria-pressed="false" disabled>
          {s.id} · {s.name}
          <span>{historyLineups.filter((l) => l.season === s.id).length}</span>
        </button>
      ))}
    </nav>
    <p class="history-note">
      保留各赛季的原配置，当前赛季为 {state.season} · {state.version_label}。
    </p>
    <Collection lineups={historyLineups} historical />
    {!historyLineups.length && (
      <div class="empty-state">
        <h2>往期阵容陆续整理中</h2>
        <p>先去看看这个赛季有哪些配队。</p>
      </div>
    )}
  </div>
</Layout>
