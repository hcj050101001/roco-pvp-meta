---
import Layout from '../../../layouts/Layout.astro';
import Collection from '../../../components/Collection.astro';
import { historyLineups, seasons, state } from '../../../lib/data';
import { seasonNumber } from '../../../lib/rank';
import { additionalStaticPages } from '../../../lib/static-pages';
import { withBase } from '../../../lib/urls';
import { breadcrumbJsonLd } from '../../../lib/seo';

export function getStaticPaths() {
  return additionalStaticPages(historyLineups.length).map((page) => ({
    params: { page: String(page) },
    props: { page },
  }));
}

const { page } = Astro.props;
const choices = seasons
  .filter((season) => historyLineups.some((lineup) => lineup.season === season.id))
  .sort((a, b) => seasonNumber(b.id) - seasonNumber(a.id));
---

<Layout
  title={`往期阵容 · 第 ${page} 页`}
  description="继续翻阅往期赛季的真实阵容配置图与资料。"
  image={historyLineups[0]?.lineup_images[0]?.path}
  section="history"
  jsonLd={breadcrumbJsonLd([
    { name: '阵容图鉴', path: '/' },
    { name: '往期阵容', path: '/history/' },
    { name: `往期阵容 · 第 ${page} 页`, path: `/history/page/${page}/` },
  ])}
>
  <section class="overview wrap static-collection-page" id="lineup-overview">
    <div class="section-heading">
      <div>
        <a class="text-link" href={withBase('/history/')}>
          ← 返回往期首页
        </a>
        <h1>往期阵容 · 第 {page} 页</h1>
      </div>
    </div>
    <nav class="season-tabs" aria-label="历史赛季">
      <button class="active" data-season-filter="all" aria-pressed="true" disabled>
        全部赛季 <span>{historyLineups.length}</span>
      </button>
      {choices.map((season) => (
        <button data-season-filter={season.id} aria-pressed="false" disabled>
          {season.id} · {season.name}
          <span>{historyLineups.filter((lineup) => lineup.season === season.id).length}</span>
        </button>
      ))}
    </nav>
    <p class="history-note">
      保留各赛季的原配置，当前赛季为 {state.season} · {state.version_label}。
    </p>
    <Collection lineups={historyLineups} historical initialPage={page} />
  </section>
</Layout>
