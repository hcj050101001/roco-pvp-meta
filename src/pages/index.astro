---
import Layout from '../layouts/Layout.astro';
import Collection from '../components/Collection.astro';
import { activeLineups,historyLineups,currentSeason,overview } from '../lib/data';
import { withBase } from '../lib/urls';
const systems=new Set(activeLineups.flatMap(l=>l.archetype));
---
<Layout title="阵容图鉴" section="overview">
  <section class="hero wrap">
    <div class="hero-copy"><div class="eyebrow">ROCO KINGDOM · TEAM HANDBOOK</div>
      <h1>选一套喜欢的队伍，<br /><span>开始下一场对战。</span></h1>
      <p class="hero-description">浏览真实配队图，找到想玩的体系。<br />配置、作者攻略与对应视频，放在一起看。</p>
      <div class="hero-actions"><a class="button primary" href="#lineup-overview">浏览阵容 <span>↓</span></a><a class="button secondary" href={withBase('/history/')}>往期配队 →</a></div>
    </div>
    <aside class="hero-index"><span class="eyebrow muted">本季手册</span><strong>{currentSeason.id}<small>{currentSeason.name}</small></strong><div class="index-stats"><span><b>{activeLineups.length}</b>套配队</span><span><b>{systems.size}</b>个体系标签</span></div><a href={withBase('/history/')}>回顾 {historyLineups.length} 套往期阵容 ↗</a></aside>
  </section>
  {overview.transition&&<aside class="transition-banner wrap"><strong>新赛季配队陆续更新</strong><p>先沿用上一赛季阵容作过渡参考，卡片保留原赛季标记。</p></aside>}
  <section class="overview wrap" id="lineup-overview"><div class="section-heading"><div><div class="eyebrow muted">{currentSeason.id} · {currentSeason.name}</div><h2>当季阵容<span>{activeLineups.length} 套</span></h2></div><span class="collection-subtitle">从主流体系，到更多配队尝试。</span></div>
    <Collection lineups={activeLineups} fallback={overview.fallback} />
  </section>
</Layout>
