---
import Layout from '../../layouts/Layout.astro';
import { allLineups,state } from '../../lib/data';
import { withBase,displayDate } from '../../lib/urls';
import { configurationDate } from '../../lib/rank';
import { absoluteUrl } from '../../lib/seo';
import type { Lineup } from '../../lib/schema';
export function getStaticPaths(){return allLineups.map(lineup=>({params:{slug:lineup.slug},props:{lineup}}));}
interface Props { lineup:Lineup }
const {lineup:l}=Astro.props;
const historical=l.status==='archived'||l.season!==state.season;
const back=historical?withBase('/history/'):withBase('/#lineup-overview');
const backLabel=historical?'← 返回往期阵容':'← 返回阵容总览';
const published=configurationDate(l);
const platforms={bilibili:'哔哩哔哩',douyin:'抖音',other:'视频'};
const evidenceLabels={A:'作者或一手来源',B:'可信图文来源',C:'转载图源·已交叉核对'};
const verifiedSkillCount=l.roster.filter(p=>p.skills.length>0).length;
const breadcrumbJsonLd={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'阵容图鉴',item:absoluteUrl(withBase('/'))},
  {'@type':'ListItem',position:2,name:historical?'往期阵容':'当季阵容',item:absoluteUrl(historical?withBase('/history/'):withBase('/#lineup-overview'))},
  {'@type':'ListItem',position:3,name:l.name,item:absoluteUrl(Astro.url.pathname)},
]};
---
<Layout title={l.name} description={l.summary} image={l.lineup_images[0].path} jsonLd={breadcrumbJsonLd} section={historical?'history':'overview'}>
  <div class="detail-nav"><div class="wrap detail-nav-inner"><a href={back}>{backLabel}</a><nav aria-label="详情导航"><a href="#configuration">配置图</a>{l.signals.length>0&&<a href="#signals">近期记录</a>}{l.guides.length>0&&<a href="#guides">作者攻略</a>}{l.tutorials.length>0&&<a href="#tutorials">教学视频</a>}<a href="#sources">来源</a></nav></div></div>
  <article class="detail wrap"><header class="detail-header"><div class="eyebrow"><span class="eyebrow-line"></span>{l.season} · {l.version_label}{historical?' / 往期阵容':''}</div><div class="detail-title"><h1>{l.name}</h1><span class="detail-edition" aria-hidden="true">{l.season}</span></div><div class="tags">{l.archetype.map(t=><span>{t}</span>)}</div><div class="detail-provenance"><span>{published?`配置发布 ${displayDate(published)}`:'配置发布日期未标注'}</span><span>{evidenceLabels[l.lineup_images[0].evidence_grade]}</span><span>资料核对于 {displayDate(l.last_verified_at)}</span></div></header>
  {historical&&<aside class="transition-banner"><strong>{l.season} 赛季配置</strong><p>保留当时配置，使用前请结合当前版本调整。</p></aside>}
  <div class="detail-columns"><div class="detail-main">
    <section id="configuration" class="detail-section"><div class="section-label"><span>CONFIGURATION</span><h2>完整配队</h2></div><p class="subtle">点击图片查看原图。</p>
      <div class="image-tabs" role="tablist" aria-label="选择阵容图" hidden={l.lineup_images.length<2}>{l.lineup_images.map((_,i)=><button role="tab" id={`tab-${i}`} aria-controls={`image-${i}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-image-tab={i}>配置 {i+1}</button>)}</div>
      {l.lineup_images.map((img,i)=><figure class="full-image" id={`image-${i}`} role={l.lineup_images.length>1?'tabpanel':undefined} aria-labelledby={l.lineup_images.length>1?`tab-${i}`:undefined} hidden={i>0}><a href={withBase(img.path)} target="_blank" rel="noopener noreferrer" aria-label={`打开${l.name}配置图 ${i+1}原图`}><img src={withBase(img.path)} width={img.width} height={img.height} alt={`${l.name}完整阵容配置：${l.roster.map(p=>p.name).join('、')}`} decoding="async" fetchpriority={i===0?'high':undefined} data-image-fallback /><span class="image-load-fallback" aria-live="polite" hidden>图片暂时无法加载，可稍后重试。</span></a><figcaption>{img.attribution}<a href={withBase(img.path)} target="_blank" rel="noopener noreferrer">查看原图 ↗</a></figcaption></figure>)}
      {l.player_notes.length>0&&<aside class="player-note">{l.player_notes.map(p=><p>{p}</p>)}</aside>}
    </section>
    {l.signals.length>0&&<section id="signals" class="detail-section"><div class="section-label"><span>PUBLIC RECORDS</span><h2>近期公开记录</h2></div>{l.signals.map(s=><a class="source-row" href={s.source_url} target="_blank" rel="noopener noreferrer"><div><span>{s.kind==='high-rank'?'公开实绩':'公开热度记录'} · {displayDate(s.observed_at)}</span><h3>{s.note}</h3></div><span>↗</span></a>)}</section>}
    <section id="tutorials" class="detail-section"><div class="section-label"><span>WATCH & LEARN</span><h2>教学与实战</h2></div>{l.tutorials.length>0?l.tutorials.map(t=><a class="source-row video-row" href={t.url} target="_blank" rel="noopener noreferrer"><div><span>{platforms[t.platform]} · {t.creator} · {displayDate(t.published_at)}</span><h3>{t.title}</h3></div><span>▷</span></a>):<p class="info-gap">暂未找到能确认对应这套阵容的教学视频。</p>}</section>
    {l.guides.length>0&&<section id="guides" class="detail-section"><div class="section-label"><span>FROM THE AUTHOR</span><h2>作者攻略摘录</h2></div>{l.guides.map(g=><figure class="guide-quote"><blockquote>{g.quote}</blockquote><figcaption><span>{g.author} · {displayDate(g.published_at)}</span><a href={g.source_url} target="_blank" rel="noopener noreferrer">阅读全文 ↗</a></figcaption></figure>)}</section>}
    <section id="roster" class="detail-section"><div class="section-label"><span>MEMBERS</span><h2>阵容成员</h2></div><p class="info-gap">{verifiedSkillCount} / 6 只精灵有已核实技能记录；未核实的技能不作补写。</p><div class="roster-list">{l.roster.map((p,i)=><div class="roster-row"><span class="roster-number">0{i+1}</span><div><h3>{p.name}</h3>{p.skills.length>0&&<div class="skill-tags">{p.skills.map(s=><span>{s}</span>)}</div>}</div>{p.bloodline&&<span class="bloodline">血脉<br /><strong>{p.bloodline}</strong></span>}</div>)}</div></section>
    <section id="sources" class="detail-section"><div class="section-label"><span>CREDITS</span><h2>配置来源</h2></div>{l.sources.map(s=><a class="source-row" href={s.url} target="_blank" rel="noopener noreferrer"><div><span>{displayDate(s.updated_at||s.published_at)}{s.updated_at?' · 帖子更新':''}</span><h3>{s.title}</h3></div><span>↗</span></a>)}</section>
    <a class="button primary bottom-return" href={back}>{backLabel}</a>
  </div><aside class="detail-sidebar"><div class="sidebar-inner"><span class="eyebrow muted">TEAM NOTES</span><h2>配队速览</h2><dl><dt>体系</dt><dd>{l.archetype.join(' / ')}</dd><dt>成员</dt><dd>{l.roster.map(p=>p.name).join('、')}</dd><dt>版本</dt><dd>{l.season} · {l.version_label}</dd></dl><a class="button secondary" href="#configuration">查看配置 ↑</a><a class="text-link sidebar-return" href={back}>{backLabel}</a></div></aside></div></article>
</Layout>
<script>
  import { safeCollectionReturn } from '../../lib/collection-state';
  const back=safeCollectionReturn(new URL(location.href).searchParams.get('returnTo'),location.origin,import.meta.env.BASE_URL);
  if(back)document.querySelectorAll<HTMLAnchorElement>('.detail-nav-inner>a,.bottom-return,.sidebar-return').forEach(link=>{
    link.href=back;link.textContent=new URL(back,location.origin).pathname.endsWith('/history/')?'← 返回往期阵容':'← 返回阵容总览';
  });
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-image-tab]')];
  function activate(tab:HTMLButtonElement){tabs.forEach(t=>{const selected=t===tab;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1;document.getElementById(`image-${t.dataset.imageTab}`)!.hidden=!selected;});}
  tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];activate(next);next.focus();}});});
  document.querySelectorAll<HTMLImageElement>('[data-image-fallback]').forEach(image => {
    image.addEventListener('error', () => {
      image.hidden = true;
      image.parentElement?.querySelector<HTMLElement>('.image-load-fallback')?.removeAttribute('hidden');
    }, { once: true });
  });
</script>
