---
import Layout from '../../layouts/Layout.astro';
import Collection from '../../components/Collection.astro';
import { activeLineups, overview } from '../../lib/data';
import { additionalStaticPages } from '../../lib/static-pages';
import { withBase } from '../../lib/urls';

export function getStaticPaths() {
  return additionalStaticPages(activeLineups.length).map((page) => ({
    params: { page: String(page) },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<Layout
  title={`当季阵容 · 第 ${page} 页`}
  description="继续浏览当季阵容的完整配置图与资料。"
  image={activeLineups[0]?.lineup_images[0]?.path}
  section="overview"
>
  <section class="overview wrap static-collection-page" id="lineup-overview">
    <div class="section-heading">
      <div>
        <a class="text-link" href={withBase('/')}>
          ← 返回当季首页
        </a>
        <h1>当季阵容 · 第 {page} 页</h1>
      </div>
    </div>
    <Collection lineups={activeLineups} fallback={overview.fallback} initialPage={page} />
  </section>
</Layout>
