---
import Layout from '../layouts/Layout.astro';
import { allLineups } from '../lib/data';
import { systemGraph } from '../lib/system-graph';
import { withBase } from '../lib/urls';
import { breadcrumbJsonLd } from '../lib/seo';

const { systems, edges } = systemGraph(allLineups);
const systemRecords = systems.map((tag, index) => ({
  tag,
  id: `system-${index + 1}`,
  lineups: allLineups.filter(
    (lineup) =>
      lineup.lineup_images.some((image) => image.verified) && lineup.archetype.includes(tag),
  ),
}));
const positions = new Map(
  systems.map((tag, index) => {
    const angle = (2 * Math.PI * index) / systems.length - Math.PI / 2;
    return [tag, { x: 480 + Math.cos(angle) * 370, y: 480 + Math.sin(angle) * 370 }] as const;
  }),
);
---

<Layout
  title="体系共现图"
  description="查看已核验阵容中体系标签共同出现的记录。"
  section="systems"
  jsonLd={breadcrumbJsonLd([
    { name: '阵容图鉴', path: '/' },
    { name: '体系共现图', path: '/systems/' },
  ])}
>
  <div class="wrap data-page">
    <header class="data-page-heading">
      <h1>体系共现图</h1>
      <p>
        连线表示两个体系标签出现在同一套已核验阵容中。可用 Tab 键选择图中标签，按 Enter
        跳到关联阵容。
      </p>
    </header>
    <div class="system-graph-scroll" role="region" aria-label="体系共现图，可横向滚动" tabindex="0">
      <svg
        class="system-graph"
        viewBox="0 0 960 960"
        aria-labelledby="graph-title graph-description"
      >
        <title id="graph-title">体系标签共现关系</title>
        <desc id="graph-description">
          {systems.length} 个标签，{edges.length} 组共同出现的标签。标签链接可跳到下方的关联阵容。
        </desc>
        {edges.map((edge) => {
          const a = positions.get(edge.first)!;
          const b = positions.get(edge.second)!;
          return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="#a9c7df" stroke-width="2" />;
        })}
        {systemRecords.map(({ tag, id }) => {
          const point = positions.get(tag)!;
          return (
            <a href={`#${id}`} aria-label={`查看${tag}关联阵容`}>
              <circle
                cx={point.x}
                cy={point.y}
                r="42"
                fill="#fff"
                stroke="#5587b2"
                stroke-width="2"
              />
              <text
                x={point.x}
                y={point.y}
                text-anchor="middle"
                dominant-baseline="middle"
                font-size="16"
                fill="#243447"
              >
                {tag}
              </text>
            </a>
          );
        })}
      </svg>
    </div>
    <h2 id="system-records">按体系浏览</h2>
    <ul class="system-node-list">
      {systemRecords.map(({ tag, id, lineups }) => (
        <li id={id}>
          <strong>{tag}</strong>
          <span>
            {lineups.map((lineup, index) => (
              <span>
                {index > 0 && '、'}
                <a href={withBase(`/lineups/${lineup.slug}/`)}>{lineup.name}</a>
              </span>
            ))}
          </span>
        </li>
      ))}
    </ul>
    <h2>共现记录</h2>
    <ul class="system-edge-list">
      {edges.map((edge) => (
        <li>
          <strong>
            {edge.first} · {edge.second}
          </strong>
          <span>共同出现于 {edge.lineups.length} 套阵容：</span>
          {edge.lineups.map((lineup, index) => (
            <span>
              {index > 0 && '、'}
              <a href={withBase(`/lineups/${lineup.slug}/`)}>{lineup.name}</a>
            </span>
          ))}
        </li>
      ))}
    </ul>
  </div>
</Layout>
