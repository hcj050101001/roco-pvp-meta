---
import Layout from '../layouts/Layout.astro';
import { allLineups } from '../lib/data';
import { timelineLineups } from '../lib/timeline';
import { configurationDate } from '../lib/rank';
import { displayDate, withBase } from '../lib/urls';
import { absoluteUrl, breadcrumbJsonLd } from '../lib/seo';

const lineups = timelineLineups(allLineups);
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  numberOfItems: lineups.length,
  itemListElement: lineups.map((lineup, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: lineup.name,
    url: absoluteUrl(withBase(`/lineups/${lineup.slug}/`)),
  })),
};
---

<Layout
  title="配置时间线"
  description="按配置图发布日期浏览已核验阵容；未标注日期的阵容单独列出。"
  section="timeline"
  jsonLd={[
    breadcrumbJsonLd([
      { name: '阵容图鉴', path: '/' },
      { name: '配置时间线', path: '/timeline/' },
    ]),
    itemListJsonLd,
  ]}
>
  <div class="wrap data-page">
    <header class="data-page-heading">
      <h1>配置时间线</h1>
      <p>按配置图发布日期排列。未标注日期的阵容列在末尾。</p>
    </header>
    <ol class="timeline-list">
      {lineups.map((lineup) => {
        const date = configurationDate(lineup);
        return (
          <li>
            <span class="timeline-date">{date ? displayDate(date) : '未标注'}</span>
            <div>
              <a href={withBase(`/lineups/${lineup.slug}/`)}>{lineup.name}</a>
              <p>
                {lineup.season} · {lineup.archetype.join(' · ')}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</Layout>
